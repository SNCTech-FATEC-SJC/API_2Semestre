<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="br.snctech.QuestaoController"
           styleClass="fundo"
           prefWidth="900" prefHeight="700">

    <VBox alignment="TOP_CENTER" spacing="18" maxWidth="720" styleClass="painel">
        <padding>
            <Insets top="28" right="28" bottom="28" left="28"/>
        </padding>

        <Label text="Cadastro de questão" styleClass="titulo-pagina"/>
        <Label text="Crie uma questão de múltipla escolha." styleClass="subtitulo-pagina"/>

        <Label text="Enunciado" styleClass="rotulo"/>
        <TextArea fx:id="campoEnunciado" wrapText="true" prefRowCount="5" styleClass="campo-texto"/>

        <Label text="Alternativas" styleClass="rotulo"/>

        <VBox spacing="10" maxWidth="Infinity">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <RadioButton text="A" selected="true"/>
                <TextField promptText="Alternativa A" HBox.hgrow="ALWAYS" styleClass="campo-texto"/>
            </HBox>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <RadioButton text="B"/>
                <TextField promptText="Alternativa B" HBox.hgrow="ALWAYS" styleClass="campo-texto"/>
            </HBox>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <RadioButton text="C"/>
                <TextField promptText="Alternativa C" HBox.hgrow="ALWAYS" styleClass="campo-texto"/>
            </HBox>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <RadioButton text="D"/>
                <TextField promptText="Alternativa D" HBox.hgrow="ALWAYS" styleClass="campo-texto"/>
            </HBox>
        </VBox>

        <HBox spacing="12">
            <Button text="Salvar questão" styleClass="botao-primario"/>
            <Button text="Limpar" styleClass="botao-secundario"/>
            <Button fx:id="botaoVoltar" text="Voltar" onAction="#aoClicarVoltar" styleClass="botao-secundario"/>
        </HBox>

        <Label fx:id="mensagem" text="Preencha os dados da questão." styleClass="mensagem"/>
    </VBox>
</StackPane>
