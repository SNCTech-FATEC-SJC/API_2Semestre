<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.snctech.BancoQuestoesController"
      styleClass="border-pane"
      prefWidth="900" prefHeight="700">

    <HBox styleClass="top-bar" prefWidth="900">
        <Label text="Professor" styleClass="top-bar-title"/>
    </HBox>

    <VBox spacing="18" styleClass="page-shell">
        <HBox alignment="CENTER_LEFT" spacing="12">
            <Label text="Banco de" styleClass="section-label strong"/>
            <Label text="Questões" styleClass="section-label strong"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="botaoVoltar" text="Voltar" onAction="#aoClicarVoltar" styleClass="top-action"/>
            <Button text="Adicionar Questão" onAction="#aoClicarAdicionarQuestao" styleClass="top-action"/>
        </HBox>

        <GridPane hgap="16" vgap="16" styleClass="card-grid">
            <columnConstraints>
                <ColumnConstraints percentWidth="20"/>
                <ColumnConstraints percentWidth="20"/>
                <ColumnConstraints percentWidth="20"/>
                <ColumnConstraints percentWidth="20"/>
                <ColumnConstraints percentWidth="20"/>
            </columnConstraints>

            <VBox styleClass="question-card" spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                <Label text="Questão 1" styleClass="title"/>
                <Label text="Enunciado resumido da questão..." styleClass="subtitle" wrapText="true"/>
                <Label text="Resposta: A" styleClass="subtitle"/>
            </VBox>

            <VBox styleClass="question-card" spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                <Label text="Questão 2" styleClass="title"/>
                <Label text="Enunciado resumido da questão..." styleClass="subtitle" wrapText="true"/>
                <Label text="Resposta: C" styleClass="subtitle"/>
            </VBox>

            <VBox styleClass="question-card" spacing="6" GridPane.columnIndex="2" GridPane.rowIndex="0">
                <Label text="Questão 3" styleClass="title"/>
                <Label text="Enunciado resumido da questão..." styleClass="subtitle" wrapText="true"/>
                <Label text="Resposta: B" styleClass="subtitle"/>
            </VBox>

            <VBox styleClass="question-card" spacing="6" GridPane.columnIndex="3" GridPane.rowIndex="0">
                <Label text="Questão 4" styleClass="title"/>
                <Label text="Enunciado resumido da questão..." styleClass="subtitle" wrapText="true"/>
                <Label text="Resposta: D" styleClass="subtitle"/>
            </VBox>

            <VBox styleClass="question-card" spacing="6" GridPane.columnIndex="4" GridPane.rowIndex="0">
                <Label text="Questão 5" styleClass="title"/>
                <Label text="Enunciado resumido da questão..." styleClass="subtitle" wrapText="true"/>
                <Label text="Resposta: A" styleClass="subtitle"/>
            </VBox>

            <VBox styleClass="question-card" spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1">
                <Label text="Questão 6" styleClass="title"/>
                <Label text="Enunciado resumido da questão..." styleClass="subtitle" wrapText="true"/>
                <Label text="Resposta: B" styleClass="subtitle"/>
            </VBox>

            <VBox styleClass="question-card" spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="1">
                <Label text="Questão 7" styleClass="title"/>
                <Label text="Enunciado resumido da questão..." styleClass="subtitle" wrapText="true"/>
                <Label text="Resposta: C" styleClass="subtitle"/>
            </VBox>

            <VBox styleClass="question-card" spacing="6" GridPane.columnIndex="2" GridPane.rowIndex="1">
                <Label text="Questão 8" styleClass="title"/>
                <Label text="Enunciado resumido da questão..." styleClass="subtitle" wrapText="true"/>
                <Label text="Resposta: D" styleClass="subtitle"/>
            </VBox>

            <VBox styleClass="question-card" spacing="6" GridPane.columnIndex="3" GridPane.rowIndex="1">
                <Label text="Questão 9" styleClass="title"/>
                <Label text="Enunciado resumido da questão..." styleClass="subtitle" wrapText="true"/>
                <Label text="Resposta: A" styleClass="subtitle"/>
            </VBox>

            <VBox styleClass="question-card" spacing="6" GridPane.columnIndex="4" GridPane.rowIndex="1">
                <Label text="Questão 10" styleClass="title"/>
                <Label text="Enunciado resumido da questão..." styleClass="subtitle" wrapText="true"/>
                <Label text="Resposta: B" styleClass="subtitle"/>
            </VBox>
        </GridPane>
    </VBox>
</VBox>
