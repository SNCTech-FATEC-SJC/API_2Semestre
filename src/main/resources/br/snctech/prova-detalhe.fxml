<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.snctech.ProvaDetalheController"
      styleClass="border-pane"
      prefWidth="900" prefHeight="700">

    <HBox styleClass="top-bar" prefWidth="900">
        <Label text="Professor" styleClass="top-bar-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Prova 1" styleClass="top-bar-title"/>
    </HBox>

    <VBox spacing="18" styleClass="page-shell">
        <HBox spacing="22">
            <VBox spacing="8" prefWidth="220">
                <Label text="Turma:" styleClass="form-label"/>
                <TextField text="1A" styleClass="form-field"/>
                <Label text="Prazo:" styleClass="form-label"/>
                <TextField text="15/09" styleClass="form-field"/>
                <Label text="Total realizado:" styleClass="form-label"/>
                <Label text="80%" styleClass="titulo-pagina"/>
                <Button text="Voltar" onAction="#aoClicarVoltar" styleClass="secondary-button" fx:id="botaoVoltar"/>
            </VBox>

            <VBox spacing="12" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Questões:" styleClass="section-label strong"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Editar" styleClass="secondary-button"/>
                </HBox>

                <GridPane hgap="16" vgap="16" styleClass="card-grid">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="20"/>
                        <ColumnConstraints percentWidth="20"/>
                        <ColumnConstraints percentWidth="20"/>
                        <ColumnConstraints percentWidth="20"/>
                        <ColumnConstraints percentWidth="20"/>
                    </columnConstraints>

                    <VBox styleClass="question-card" spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="Questão 1" styleClass="title"/>
                        <Label text="Enunciado resumido..." styleClass="subtitle" wrapText="true"/>
                    </VBox>

                    <VBox styleClass="question-card" spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label text="Questão 2" styleClass="title"/>
                        <Label text="Enunciado resumido..." styleClass="subtitle" wrapText="true"/>
                    </VBox>

                    <VBox styleClass="question-card" spacing="6" GridPane.columnIndex="2" GridPane.rowIndex="0">
                        <Label text="Questão 3" styleClass="title"/>
                        <Label text="Enunciado resumido..." styleClass="subtitle" wrapText="true"/>
                    </VBox>

                    <VBox styleClass="question-card" spacing="6" GridPane.columnIndex="3" GridPane.rowIndex="0">
                        <Label text="Questão 4" styleClass="title"/>
                        <Label text="Enunciado resumido..." styleClass="subtitle" wrapText="true"/>
                    </VBox>

                    <VBox styleClass="question-card" spacing="6" GridPane.columnIndex="4" GridPane.rowIndex="0">
                        <Label text="Questão 5" styleClass="title"/>
                        <Label text="Enunciado resumido..." styleClass="subtitle" wrapText="true"/>
                    </VBox>
                </GridPane>
            </VBox>
        </HBox>
    </VBox>
</VBox>
