<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.snctech.BancoQuestoesController"
      styleClass="border-pane"
      prefWidth="900"
      prefHeight="700">

    <HBox styleClass="top-bar" prefWidth="900">
        <Label text="Professor" styleClass="top-bar-title"/>
    </HBox>

    <VBox spacing="18" styleClass="page-shell"
          VBox.vgrow="ALWAYS">

        <HBox alignment="CENTER_LEFT" spacing="12">

            <Label text="Banco de"
                   styleClass="section-label strong"/>

            <Label text="Questões"
                   styleClass="section-label strong"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button fx:id="botaoVoltar"
                    text="Voltar"
                    onAction="#aoClicarVoltar"
                    styleClass="top-action"/>

            <Button text="Adicionar Questão"
                    onAction="#aoClicarAdicionarQuestao"
                    styleClass="top-action"/>

        </HBox>

        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    VBox.vgrow="ALWAYS"
                    styleClass="fundo">

            <content>

                <GridPane fx:id="gradeQuestoes"
                          hgap="16"
                          vgap="16"
                          styleClass="card-grid">

                    <columnConstraints>
                        <ColumnConstraints percentWidth="20"/>
                        <ColumnConstraints percentWidth="20"/>
                        <ColumnConstraints percentWidth="20"/>
                        <ColumnConstraints percentWidth="20"/>
                        <ColumnConstraints percentWidth="20"/>
                    </columnConstraints>

                    <padding>
                        <Insets top="4" right="4" bottom="4" left="4"/>
                    </padding>

                </GridPane>

            </content>

        </ScrollPane>

    </VBox>

</VBox>
