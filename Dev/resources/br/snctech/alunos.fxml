<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="br.snctech.alunos.controller.AlunosController"
           styleClass="fundo"
           prefWidth="1000" prefHeight="700">

    <VBox alignment="TOP_CENTER" spacing="22" maxWidth="1100">
        <padding>
            <Insets top="30" right="30" bottom="30" left="30"/>
        </padding>

        <HBox styleClass="top-bar">
            <Label text="Professor " styleClass="top-bar-title"/>
            <Label text="Gerenciamento de Alunos" styleClass="top-bar-title" HBox.hgrow="ALWAYS"/>
        </HBox>

        <VBox spacing="14" styleClass="content-panel" VBox.vgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="2">
                    <Label text="Alunos" styleClass="titulo-pagina"/>
                    <Label fx:id="labelResumo" text="" styleClass="subtitulo-pagina"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="botaoVoltar" text="Voltar" onAction="#aoClicarVoltar" styleClass="botao-secundario"/>
            </HBox>

            <TextField fx:id="campoBusca" promptText="Buscar por nome, e-mail ou turma" styleClass="campo-texto"/>

            <TableView fx:id="tabela" VBox.vgrow="ALWAYS"/>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button fx:id="botaoNovo" text="Novo aluno" onAction="#aoClicarNovo" styleClass="botao-primario"/>
                <Button fx:id="botaoEditar" text="Editar" onAction="#aoClicarEditar" styleClass="botao-secundario"/>
                <Button fx:id="botaoRemover" text="Remover" onAction="#aoClicarRemover" styleClass="botao-secundario"/>
                <Button fx:id="botaoTurmas" text="Gerenciar turmas" onAction="#aoClicarTurmas" styleClass="botao-secundario"/>
            </HBox>

            <Label fx:id="labelMensagem" text="" styleClass="mensagem" wrapText="true"/>
        </VBox>
    </VBox>
</StackPane>
