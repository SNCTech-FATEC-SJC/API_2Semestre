<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="br.snctech.alunos.controller.MinhasTurmasController"
           styleClass="fundo"
           prefWidth="1000" prefHeight="700">

    <VBox alignment="TOP_CENTER" spacing="22" maxWidth="1100">
        <padding>
            <Insets top="30" right="30" bottom="30" left="30"/>
        </padding>

        <HBox styleClass="top-bar">
            <Label text="Aluno " styleClass="top-bar-title"/>
            <Label text="Minhas Turmas" styleClass="top-bar-title" HBox.hgrow="ALWAYS"/>
        </HBox>

        <VBox spacing="14" styleClass="content-panel" VBox.vgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="2">
                    <Label text="Minhas turmas" styleClass="titulo-pagina"/>
                    <Label fx:id="labelResumo" text="" styleClass="subtitulo-pagina"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="botaoVoltar" text="Voltar" onAction="#aoClicarVoltar" styleClass="botao-secundario"/>
            </HBox>

            <TableView fx:id="tabela" VBox.vgrow="ALWAYS"/>

            <Label fx:id="labelMensagem" text="" styleClass="mensagem" wrapText="true"/>
        </VBox>
    </VBox>
</StackPane>
