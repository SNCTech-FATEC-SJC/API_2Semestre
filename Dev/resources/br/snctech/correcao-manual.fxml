<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Tela 7 - Correção manual do aluno. PB-03. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.snctech.correcao.controller.CorrecaoManualController"
      styleClass="border-pane, corr-raiz" stylesheets="@correcao.css" prefWidth="1100" prefHeight="720">

    <HBox styleClass="top-bar" spacing="16">
        <Label text="Professor" styleClass="top-bar-title"/>
        <Label fx:id="tituloTela" text="Correção manual" styleClass="top-bar-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <ComboBox fx:id="seletorAluno" promptText="Escolha um aluno"/>
    </HBox>

    <HBox spacing="16" styleClass="page-shell" VBox.vgrow="ALWAYS">
        <VBox spacing="12" prefWidth="280" minWidth="280">
            <VBox fx:id="colunaResumo" spacing="12"/>
            <Button fx:id="botaoVoltar" text="Voltar à lista de alunos" onAction="#aoClicarVoltar"
                    styleClass="secondary-button"/>
        </VBox>
        <ScrollPane fx:id="rolagem" fitToWidth="true" HBox.hgrow="ALWAYS" styleClass="rolagem-transparente">
            <VBox fx:id="listaQuestoes" spacing="12"/>
        </ScrollPane>
    </HBox>
</VBox>
