<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.snctech.ResponderAvaliacaoController" styleClass="border-pane" prefWidth="900" prefHeight="700">
    <HBox styleClass="top-bar" prefWidth="900">
        <Label text="Aluno" styleClass="top-bar-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="tituloProva" text="Responder avaliação" styleClass="top-bar-title"/>
    </HBox>
    <VBox spacing="14" styleClass="page-shell" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="12">
            <Label fx:id="rotuloAluno" styleClass="section-label strong"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="cronometro" styleClass="cronometro"/>
        </HBox>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS" styleClass="fundo">
            <content>
                <VBox fx:id="listaQuestoes" spacing="12" styleClass="fundo"/>
            </content>
        </ScrollPane>
        <Label fx:id="mensagem" wrapText="true" styleClass="mensagem"/>
        <HBox spacing="12" alignment="CENTER_RIGHT">
            <Button fx:id="botaoSair" text="Sair sem entregar" onAction="#aoClicarSair" styleClass="secondary-button"/>
            <Button fx:id="botaoEntregar" text="Entregar avaliação" onAction="#aoClicarEntregar" styleClass="primary-button"/>
        </HBox>
    </VBox>
</VBox>
