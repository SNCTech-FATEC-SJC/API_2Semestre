<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.snctech.avaliacoes.controller.ProvasAplicadasController" styleClass="border-pane" prefWidth="900" prefHeight="700">
    <HBox styleClass="top-bar" prefWidth="900">
        <Label text="Professor" styleClass="top-bar-title"/>
        <Region HBox.hgrow="ALWAYS"/>
    </HBox>
    <VBox spacing="18" styleClass="page-shell" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="12">
            <Label text="Avaliações cadastradas" styleClass="section-label strong"/><Region HBox.hgrow="ALWAYS"/>
            <Button text="Voltar" onAction="#aoClicarVoltar" styleClass="top-action" fx:id="botaoVoltar"/>
            <Button text="Nova Prova" onAction="#aoClicarNovaProva" styleClass="top-action"/>
        </HBox>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS" styleClass="fundo">
            <content><FlowPane fx:id="listaProvas" hgap="16" vgap="16" prefWrapLength="780" styleClass="card-grid"/></content>
        </ScrollPane>
    </VBox>
</VBox>
