<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.snctech.ProvasAplicadasController" styleClass="border-pane" prefWidth="900" prefHeight="700">
    <HBox styleClass="top-bar" prefWidth="900"><Label text="Professor" styleClass="top-bar-title"/></HBox>
    <VBox spacing="18" styleClass="page-shell">
        <HBox alignment="CENTER_LEFT" spacing="12">
            <Label text="Avaliações cadastradas" styleClass="section-label strong"/><Region HBox.hgrow="ALWAYS"/>
            <Button text="Voltar" onAction="#aoClicarVoltar" styleClass="top-action" fx:id="botaoVoltar"/>
            <Button text="Nova Prova" onAction="#aoClicarNovaProva" styleClass="top-action"/>
        </HBox>
        <GridPane fx:id="listaProvas" hgap="16" vgap="16" styleClass="card-grid">
            <columnConstraints><ColumnConstraints percentWidth="33.33"/><ColumnConstraints percentWidth="33.33"/><ColumnConstraints percentWidth="33.34"/></columnConstraints>
        </GridPane>
    </VBox>
</VBox>
