<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.snctech.notas.controller.NotasTurmaController" styleClass="border-pane" prefWidth="1000" prefHeight="700">
    <HBox styleClass="top-bar">
        <Label text="Professor" styleClass="top-bar-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Notas e médias" styleClass="top-bar-title"/>
    </HBox>
    <VBox spacing="14" styleClass="page-shell" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="12">
            <Label text="Notas e médias da turma" styleClass="titulo-pagina"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="botaoVoltar" text="Voltar" onAction="#aoClicarVoltar" styleClass="top-action"/>
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="12">
            <Label text="Turma" styleClass="section-label strong"/>
            <ComboBox fx:id="comboTurma" prefWidth="320" promptText="Selecione a turma"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="botaoAtualizar" text="Atualizar" onAction="#aoClicarAtualizar" styleClass="secondary-button"/>
            <Button fx:id="botaoLiberar" text="Liberar médias" onAction="#aoClicarLiberar" styleClass="primary-button"/>
        </HBox>
        <Label fx:id="mensagem" wrapText="true" minHeight="-Infinity" styleClass="mensagem"/>
        <TableView fx:id="tabela" VBox.vgrow="ALWAYS"/>
    </VBox>
</VBox>
