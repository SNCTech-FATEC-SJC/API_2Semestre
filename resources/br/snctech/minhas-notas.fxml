<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.snctech.avaliacoes.controller.AvaliacoesAlunoController" styleClass="border-pane" prefWidth="900" prefHeight="700">
    <HBox styleClass="top-bar">
        <Label text="Aluno" styleClass="top-bar-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Minhas notas" styleClass="top-bar-title"/>
    </HBox>
    <VBox spacing="18" styleClass="page-shell" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="12">
            <Label text="Notas e correções" styleClass="section-label strong"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Voltar ao início" onAction="#aoClicarVoltar" styleClass="secondary-button"/>
        </HBox>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS" styleClass="fundo">
            <content><VBox fx:id="listaNotas" spacing="10"/></content>
        </ScrollPane>
    </VBox>
</VBox>
