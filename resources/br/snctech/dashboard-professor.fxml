<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="br.snctech.dashboard.controller.DashboardProfessorController"
           styleClass="fundo"
           prefWidth="900" prefHeight="700">

    <ScrollPane fitToWidth="true" hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED" styleClass="fundo">
    <content>
    <VBox alignment="TOP_CENTER" spacing="22" maxWidth="Infinity">
        <padding>
            <Insets top="30" right="30" bottom="30" left="30"/>
        </padding>

        <HBox styleClass="top-bar" spacing="10">
            <Label fx:id="labelUsuario" text="Professor" styleClass="top-bar-title"/>
            <Label text="- Menu principal" styleClass="top-bar-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="botaoSair" text="Sair da conta" onAction="#aoClicarSair" styleClass="top-bar-button"/>
            <Button fx:id="botaoFechar" text="Fechar aplicação" onAction="#aoClicarFechar" styleClass="top-bar-button"/>
        </HBox>
        <HBox spacing="26" styleClass="page-shell" VBox.vgrow="ALWAYS">
            <VBox spacing="12" styleClass="menu-panel">
                <Label text="Navegação" styleClass="section-label strong"/>
                <Button fx:id="botaoQuestoes" onAction="#aoClicarQuestoes" text="Banco de Questões" styleClass="menu-button"/>
                <Button fx:id="botaoAvaliacoes" onAction="#aoClicarAvaliacoes" text="Provas Aplicadas" styleClass="menu-button"/>
                <Button fx:id="botaoTurmas" onAction="#aoClicarTurmas" text="Gerenciamento de Turmas" styleClass="menu-button"/>
                <Button fx:id="botaoAlunos" onAction="#aoClicarAlunos" text="Gerenciamento de Alunos" styleClass="menu-button"/>
                <Button fx:id="botaoNotas" onAction="#aoClicarNotas" text="Notas e Médias" styleClass="menu-button"/>
            </VBox>
            <VBox spacing="18" styleClass="content-panel" HBox.hgrow="ALWAYS">
                <Label text="Professor" styleClass="titulo-pagina"/>
                <Label text="Painel principal" styleClass="subtitulo-pagina"/>
                <FlowPane hgap="12" vgap="12" prefWrapLength="440">
                    <VBox styleClass="metric-box"><Label text="Questões" styleClass="title"/><Label fx:id="totalQuestoes" text="0" styleClass="value"/></VBox>
                    <VBox styleClass="metric-box"><Label text="Provas" styleClass="title"/><Label fx:id="totalProvas" text="0" styleClass="value"/></VBox>
                    <VBox styleClass="metric-box"><Label text="Turmas" styleClass="title"/><Label fx:id="totalTurmas" text="0" styleClass="value"/></VBox>
                </FlowPane>
                <VBox styleClass="chart-box" VBox.vgrow="ALWAYS">
                    <Label text="Visão geral" styleClass="section-label"/>
                    <Label text="Os indicadores acima refletem os registros disponíveis no banco de dados." styleClass="subtitulo-pagina" wrapText="true"/>
                </VBox>
            </VBox>
        </HBox>
    </VBox>
    </content>
    </ScrollPane>
</StackPane>
