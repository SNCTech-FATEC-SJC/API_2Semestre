<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="br.snctech.ProvaDetalheController" styleClass="border-pane" prefWidth="900" prefHeight="700">
    <HBox styleClass="top-bar" prefWidth="900"><Label text="Professor" styleClass="top-bar-title"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="tituloProva" text="Detalhes da avaliação" styleClass="top-bar-title"/></HBox>
    <VBox spacing="18" styleClass="page-shell">
        <Label text="Questões desta avaliação" styleClass="section-label strong"/>
        <VBox fx:id="detalhesQuestoes" spacing="12"/>
        <HBox spacing="12">
            <Button text="Voltar" onAction="#aoClicarVoltar" styleClass="secondary-button" fx:id="botaoVoltar"/>
            <Button text="Editar avaliação" onAction="#aoClicarEditar" styleClass="primary-button"/>
        </HBox>
    </VBox>
</VBox>
